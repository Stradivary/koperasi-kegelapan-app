{
  "name": "koperasi-kegelapan",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "dev:api": "wrangler dev --config wrangler.api.jsonc --port 8787",
    "build": "vite build",
    "build:api": "wrangler deploy --config wrangler.api.jsonc --dry-run",
    "preview": "vite preview",
    "deploy:pages": "pnpm run build && wrangler pages deploy",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc",
    "deploy:api-stage": "wrangler deploy --config wrangler.api.staging.jsonc",
    "deploy": "pnpm run deploy:pages && pnpm run deploy:api",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:local:migrate": "wrangler d1 migrations apply DB --local --config wrangler.api.jsonc",
    "db:local:query": "wrangler d1 execute DB --local --config wrangler.api.jsonc --command",
    "db:local:seed": "tsx src/db/seed.ts",
    "db:remote:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.api.jsonc",
    "db:remote:query": "wrangler d1 execute DB --remote --config wrangler.api.jsonc --command",
    "db:remote:seed": "tsx src/db/seed-remote.ts",
    "db:remote-stage:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.api.staging.jsonc",
    "db:remote-stage:query": "wrangler d1 execute DB --remote --config wrangler.api.staging.jsonc --command",
    "db:remote-stage:seed": "tsx src/db/seed-remote.ts --staging",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "^1.168.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "dexie": "^4.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-resizable-panels": "^4.11.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^1.0.0-rc.3",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.5.2",
    "oxfmt": "latest",
    "oxlint": "^0.16.12",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,css,html,yaml,toml}": [
      "oxfmt"
    ]
  }
}
