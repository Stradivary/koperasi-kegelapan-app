{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koperasi-kegelapan-app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "koperasi-kegelapan",
      // Run: wrangler d1 create koperasi-kegelapan  — then paste the returned database_id here
      "database_id": "62122eed-8454-4751-986d-6dcf12fb3d2e",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    // Override in .dev.vars for local development
    "SESSION_MASTER_KEY": "5259e877-e293-4dc2-8c05-c6b40654a51c", 
  },
}
